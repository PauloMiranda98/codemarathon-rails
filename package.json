{
  "name": "codemarathon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node --input-type=module -e \"import fs from 'fs'; fs.cpSync('contents', 'dist/contents', { recursive: true });\"",
    "preview": "vite preview",
    "deploy": "yarn build && gh-pages -d dist"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "flowbite": "^1.8.1",
    "flowbite-react": "^0.12.17",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}