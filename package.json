{
  "name": "codemarathon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node --input-type=module -e \"import fs from 'fs'; fs.cpSync('contents', 'dist/contents', { recursive: true });\"",
    "preview": "vite preview",
    "deploy": "yarn build && gh-pages -d dist"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.9",
    "flowbite": "^1.6.5",
    "flowbite-react": "^0.4.7",
    "highlight.js": "^11.8.0",
    "katex": "^0.16.8",
    "marked": "^5.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.2"
  },
  "devDependencies": {
    "@types/katex": "^0.16.0",
    "@types/node": "^20.4.2",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "gh-pages": "^5.0.0",
    "postcss": "^8.4.26",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.1.6",
    "vite": "^4.4.4"
  }
}
